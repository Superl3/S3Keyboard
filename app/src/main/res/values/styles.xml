<resources>
    <style name="AppThemeBase" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:colorAccent">#14545A</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>

    <style name="AppTheme" parent="@style/AppThemeBase" />

    <style name="VoiceInputProxyTheme" parent="@android:style/Theme.Translucent.NoTitleBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowDisablePreview">true</item>
    </style>

    <style name="TransparentInputMethodTheme" parent="@android:style/Theme.InputMethod">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:imeFullscreenBackground">@android:color/transparent</item>
        <item name="android:colorBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowDisablePreview">true</item>
    </style>
</resources>
