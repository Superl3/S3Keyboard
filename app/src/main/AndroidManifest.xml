<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ThemeEditorActivity"
            android:exported="false"
            android:label="@string/theme_editor_activity_label" />

        <activity
            android:name=".ThemeSelectorActivity"
            android:exported="false"
            android:label="@string/theme_selector_activity_label" />

        <activity
            android:name=".AccentPlacementActivity"
            android:exported="false"
            android:label="@string/accent_placement_activity_label" />

        <activity
            android:name=".LayoutEditorActivity"
            android:exported="false"
            android:label="@string/layout_editor_activity_label"
            android:theme="@android:style/Theme.NoTitleBar.Fullscreen"
            android:configChanges="orientation|screenSize"
            android:windowSoftInputMode="stateAlwaysHidden" />

        <activity
            android:name=".VoiceInputActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:theme="@style/VoiceInputProxyTheme" />

        <service
            android:name=".S3KeyboardService"
            android:exported="true"
            android:label="@string/ime_name"
            android:theme="@style/TransparentInputMethodTheme"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>
    </application>
</manifest>
