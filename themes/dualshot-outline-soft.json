{
  "schemaVersion": 1,
  "name": "Dualshot Outline Soft",
  "author": "local",
  "metadata": {
    "tags": [
      "light",
      "keycapInspired",
      "outline",
      "flat"
    ],
    "features": [
      "dingulRoleColors",
      "separateOutline",
      "noveltyKeys"
    ]
  },
  "colors": {
    "alphaKey": "#B7BABE",
    "modifierKey": "#303238",
    "accentKey": "#CB746D",
    "keyPressed": "#9FA3A8",
    "keyboardBackground": "#676A6E",
    "border": "#4E5359",
    "depth": "#292B2F",
    "accent": "#24262A",
    "secondary": "#5CB6C9"
  },
  "outlineColors": {
    "default": "#646A72",
    "alpha": "#767C84",
    "modifier": "#D27B74",
    "accent": "#55B4C8",
    "novelty": "#D27B74"
  },
  "shape": {
    "roundnessDp": 7,
    "borderWidthDp": 2,
    "keyGapDp": 5,
    "depthEnabled": false,
    "depthDp": 0
  },
  "additionalNumberRow": {
    "colorMode": "full_mod"
  },
  "typography": {
    "fontFamily": "noto_sans_kr",
    "primaryTextSizePercent": 78,
    "secondaryTextSizePercent": 80,
    "primaryTextBold": false,
    "primaryTextItalic": false,
    "secondaryTextBold": true,
    "secondaryTextItalic": false
  },
  "keyTextColorOverrides": {
    "shiftIndicator": "#5CB6C9"
  },
  "dingulColors": {
    "alpha": {
      "foreground": "#24262A",
      "background": "#B7BABE"
    },
    "mod": {
      "foreground": "#E8EBEE",
      "background": "#303238"
    },
    "modInv": {
      "foreground": "#24262A",
      "background": "#CB746D"
    }
  },
  "effects": {
    "blur": {
      "enabled": false,
      "radiusDp": 0
    },
    "glass": {
      "enabled": false,
      "tintAlphaPercent": 86,
      "highlightPercent": 18,
      "borderAlphaPercent": 42
    },
    "metal": {
      "enabled": false,
      "strengthPercent": 0
    },
    "previewBubble": {
      "style": "rounded"
    },
    "keyFaceGradient": {
      "enabled": false,
      "strengthPercent": 0,
      "startColor": "#FFFFFF",
      "endColor": "#292B2F",
      "curve": "soft"
    },
    "panelGradient": {
      "enabled": false,
      "startColor": "#30343A",
      "endColor": "#15181C"
    },
    "materialStyle": "solid"
  },
  "accentPolicy": {
    "spacebar": "mod",
    "qwerty": [
      "qwertyShift",
      "backspace"
    ],
    "dingul": [
      "dingulDot"
    ]
  },
  "novelties": {
    "keys": {
      "enter": {
        "type": "icon",
        "value": "gmk_iso_enter_mark"
      },
      "reserved": {
        "type": "icon",
        "value": "gmk_orbit_star"
      },
      "space": {
        "type": "icon",
        "value": "gmk_side_stripes"
      }
    }
  }
}
