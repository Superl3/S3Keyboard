{
  "schemaVersion": 1,
  "name": "Android Material Light",
  "author": "local",
  "metadata": {
    "recommendedHints": {
      "showHangulSlideHints": true,
      "showEnglishSlideHints": false,
      "showBeginnerTooltipPreview": true
    },
    "tags": [
      "flat",
      "light",
      "platformInspired"
    ],
    "features": [
      "dingulRoleColors",
      "historicalHintRecommendation"
    ]
  },
  "colors": {
    "alphaKey": "#FFFBFE",
    "modifierKey": "#ECE6F0",
    "accentKey": "#E1DCE8",
    "keyPressed": "#D0C4DB",
    "keyboardBackground": "#F3EDF7",
    "border": "#CAC4D0",
    "depth": null,
    "accent": "#1D1B20",
    "secondary": "#625B71"
  },
  "shape": {
    "roundnessDp": 8,
    "keyGapDp": 4,
    "depthEnabled": false,
    "depthDp": 0,
    "borderWidthDp": 0
  },
  "additionalNumberRow": {
    "colorMode": "full_mod"
  },
  "typography": {
    "fontFamily": "noto_sans_kr",
    "primaryTextSizePercent": 80,
    "secondaryTextSizePercent": 74,
    "primaryTextBold": false,
    "primaryTextItalic": false,
    "secondaryTextBold": false,
    "secondaryTextItalic": false
  },
  "dingulColors": {
    "alpha": {
      "foreground": "#1D1B20",
      "background": "#FFFBFE"
    },
    "mod": {
      "foreground": "#625B71",
      "background": "#ECE6F0"
    },
    "modInv": {
      "foreground": "#ECE6F0",
      "background": "#E1DCE8"
    }
  },
  "keyTextColorOverrides": {
    "shiftIndicator": "#16A34A"
  },
  "effects": {
    "glass": {
      "enabled": false,
      "tintAlphaPercent": 86,
      "highlightPercent": 18,
      "borderAlphaPercent": 42
    },
    "blur": {
      "enabled": false,
      "radiusDp": 0
    },
    "metal": {
      "enabled": false,
      "strengthPercent": 0
    },
    "keyFaceGradient": {
      "enabled": false,
      "strengthPercent": 0,
      "startColor": "#FFFFFF",
      "endColor": "#CAC4D0",
      "curve": "soft"
    },
    "panelGradient": {
      "enabled": false
    },
    "materialStyle": "solid"
  }
