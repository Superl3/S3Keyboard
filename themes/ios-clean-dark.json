{
  "schemaVersion": 1,
  "name": "iOS Clean Dark",
  "author": "local",
  "metadata": {
    "recommendedHints": {
      "showHangulSlideHints": false,
      "showEnglishSlideHints": false,
      "showBeginnerTooltipPreview": true
    },
    "tags": [
      "dark",
      "flat",
      "minimal",
      "platformInspired"
    ],
    "features": [
      "dingulRoleColors",
      "historicalHintRecommendation"
    ]
  },
  "colors": {
    "alphaKey": "#2B2D31",
    "modifierKey": "#3A3D43",
    "accentKey": "#202328",
    "keyPressed": "#5A5E66",
    "keyboardBackground": "#1D1F23",
    "border": "#202328",
    "depth": null,
    "accent": "#F8FAFC",
    "secondary": "#B8BEC8"
  },
  "shape": {
    "roundnessDp": 9,
    "keyGapDp": 4,
    "depthEnabled": false,
    "depthDp": 0,
    "borderWidthDp": 0
  },
  "additionalNumberRow": {
    "colorMode": "full_mod"
  },
  "typography": {
    "fontFamily": "noto_sans_kr",
    "primaryTextSizePercent": 80,
    "secondaryTextSizePercent": 72,
    "primaryTextBold": false,
    "primaryTextItalic": false,
    "secondaryTextBold": false,
    "secondaryTextItalic": false
  },
  "dingulColors": {
    "alpha": {
      "foreground": "#F8FAFC",
      "background": "#2B2D31"
    },
    "mod": {
      "foreground": "#B8BEC8",
      "background": "#3A3D43"
    },
    "modInv": {
      "foreground": "#3A3D43",
      "background": "#202328"
    }
  },
  "keyTextColorOverrides": {
    "shiftIndicator": "#06B6D4"
  },
  "effects": {
    "glass": {
      "enabled": false,
      "tintAlphaPercent": 86,
      "highlightPercent": 18,
      "borderAlphaPercent": 42
    },
    "blur": {
      "enabled": false,
      "radiusDp": 0
    },
    "metal": {
      "enabled": false,
      "strengthPercent": 0
    },
    "keyFaceGradient": {
      "enabled": false,
      "strengthPercent": 0,
      "startColor": "#FFFFFF",
      "endColor": "#202328",
      "curve": "soft"
    },
    "panelGradient": {
      "enabled": false
    },
    "materialStyle": "solid"
  }
}
