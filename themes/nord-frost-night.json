{
  "schemaVersion": 1,
  "name": "Nord Frost Night",
  "author": "local",
  "metadata": {
    "recommendedHints": {
      "showHangulSlideHints": true,
      "showEnglishSlideHints": false,
      "showBeginnerTooltipPreview": true
    },
    "tags": [
      "dark",
      "frosted"
    ],
    "features": [
      "dingulRoleColors",
      "historicalHintRecommendation",
      "keyFaceGradient",
      "blurEffect",
      "keyDepth"
    ]
  },
  "colors": {
    "alphaKey": "#2E3440",
    "modifierKey": "#3B4252",
    "accentKey": "#252B35",
    "keyPressed": "#4C566A",
    "keyboardBackground": "#242933",
    "border": "#69768A",
    "depth": "#1E2430",
    "accent": "#ECEFF4",
    "secondary": "#C7D0DC"
  },
  "shape": {
    "roundnessDp": 8,
    "keyGapDp": 5,
    "depthEnabled": true,
    "depthDp": 1,
    "borderWidthDp": 1
  },
  "additionalNumberRow": {
    "colorMode": "full_mod"
  },
  "typography": {
    "fontFamily": "noto_sans_kr",
    "primaryTextSizePercent": 78,
    "secondaryTextSizePercent": 80,
    "primaryTextBold": false,
    "primaryTextItalic": false,
    "secondaryTextBold": true,
    "secondaryTextItalic": false
  },
  "dingulColors": {
    "alpha": {
      "foreground": "#ECEFF4",
      "background": "#2E3440"
    },
    "mod": {
      "foreground": "#C7D0DC",
      "background": "#3B4252"
    },
    "modInv": {
      "foreground": "#3B4252",
      "background": "#252B35"
    }
  },
  "keyTextColorOverrides": {
    "shiftIndicator": "#06B6D4"
  },
  "effects": {
    "blur": {
      "enabled": true,
      "radiusDp": 16
    },
    "glass": {
      "enabled": true,
      "tintAlphaPercent": 90,
      "highlightPercent": 10,
      "borderAlphaPercent": 32
    },
    "metal": {
      "enabled": false,
      "strengthPercent": 0
    },
    "previewBubble": {
      "style": "rounded"
    },
    "keyFaceGradient": {
      "enabled": true,
      "strengthPercent": 8,
      "startColor": "#FFFFFF",
      "endColor": "#69768A",
      "curve": "soft"
    },
    "panelGradient": {
      "enabled": false,
      "startColor": "#41495A",
      "endColor": "#202631"
    },
    "materialStyle": "frosted"
  }
}
