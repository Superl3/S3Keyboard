  "dingulColors": {
    "alpha": {
      "foreground": "#161616",
      "background": "#F5F5F5"
    },
    "mod": {
      "foreground": "#686868",
      "background": "#E8E8E8"
    },
    "modInv": {
      "foreground": "#E8E8E8",
      "background": "#DDDDDD"
    }
  },
  "keyTextColorOverrides": {
    "shiftIndicator": "#16A34A"
  },
