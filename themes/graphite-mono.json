    "blur": {
      "enabled": false,
      "radiusDp": 0
    },
    "metal": {
      "enabled": false,
      "strengthPercent": 0
    },
    "keyFaceGradient": {
      "enabled": false,
      "strengthPercent": 0,
      "startColor": "#FFFFFF",
      "endColor": "#B8B8B8",
      "curve": "soft"
