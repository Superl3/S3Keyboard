{
  "schemaVersion": 1,
  "name": "macOS Graphite Dark",
  "author": "local",
  "metadata": {
    "recommendedHints": {
      "showHangulSlideHints": true,
      "showEnglishSlideHints": false,
      "showBeginnerTooltipPreview": true
    },
    "tags": [
      "dark",
      "minimal",
      "platformInspired",
      "flat"
    ],
    "features": [
      "dingulRoleColors",
      "historicalHintRecommendation"
    ]
  },
  "colors": {
    "alphaKey": "#30343A",
    "modifierKey": "#3B414A",
    "accentKey": "#252B32",
    "keyPressed": "#596271",
    "keyboardBackground": "#20242A",
    "border": "#15191F",
    "depth": "#15191F",
    "accent": "#F4F7FA",
    "secondary": "#AEB7C4"
  },
  "shape": {
    "roundnessDp": 6,
    "keyGapDp": 4,
    "depthEnabled": false,
    "depthDp": 0,
    "borderWidthDp": 1
  },
  "additionalNumberRow": {
    "colorMode": "full_mod"
  },
  "typography": {
    "fontFamily": "noto_sans_kr",
    "primaryTextSizePercent": 78,
    "secondaryTextSizePercent": 80,
    "primaryTextBold": false,
    "primaryTextItalic": false,
    "secondaryTextBold": true,
    "secondaryTextItalic": false
  },
  "dingulColors": {
    "alpha": {
      "foreground": "#F4F7FA",
      "background": "#30343A"
    },
    "mod": {
      "foreground": "#AEB7C4",
      "background": "#3B414A"
    },
    "modInv": {
      "foreground": "#3B414A",
      "background": "#252B32"
    }
  },
  "keyTextColorOverrides": {
    "shiftIndicator": "#16A34A"
  },
  "effects": {
    "glass": {
      "enabled": false,
      "tintAlphaPercent": 86,
      "highlightPercent": 18,
      "borderAlphaPercent": 42
    },
    "blur": {
      "enabled": false,
      "radiusDp": 0
    },
    "metal": {
      "enabled": false,
      "strengthPercent": 0
    },
    "keyFaceGradient": {
      "enabled": false,
      "strengthPercent": 0,
      "startColor": "#FFFFFF",
      "endColor": "#15191F",
      "curve": "soft"
    },
    "panelGradient": {
      "enabled": false
    },
    "materialStyle": "solid"
  }
}
